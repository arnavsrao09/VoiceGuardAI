# VoiceGuardAI Frontend Environment Variables

# Set your deployed Render backend URL here for Vercel deployment:
VITE_BACKEND_URL=https://your-voiceguard-backend.onrender.com

# Alternatively, configure API and WS URLs explicitly:
# VITE_API_URL=https://your-voiceguard-backend.onrender.com/api/v1
# VITE_WS_URL=wss://your-voiceguard-backend.onrender.com
