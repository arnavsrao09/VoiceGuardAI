APP_NAME=VoiceGuardAI
APP_VERSION=0.1.0
DEBUG=true

API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceguardai

REDIS_URL=redis://localhost:6379/0

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

AASIST_WINDOW_SAMPLES=64600
AASIST_HOP_MS=250

VAD_THRESHOLD=0.5

DEEPFAKE_WEIGHT=0.45
SPEAKER_WEIGHT=0.25
PROSODY_WEIGHT=0.15
CONTEXT_WEIGHT=0.15

EMA_ALPHA=0.3

LOW_RISK_THRESHOLD=0.30
MEDIUM_RISK_THRESHOLD=0.60
HIGH_RISK_THRESHOLD=0.80

SPEAKER_SIMILARITY_THRESHOLD=0.75

RAW_AUDIO_RETENTION=false
TELEMETRY_RETENTION_DAYS=90

AASIST_MODEL_PATH=models/aasist
ECAPA_MODEL_PATH=models/ecapa

MOCK_ML=false
