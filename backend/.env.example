# VoiceGuardAI Backend Environment Variables

# App
DEBUG=true

# PostgreSQL (pgvector)
# For local Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/voiceguard
# For Supabase (Cloud):
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# ML Model Paths (ONNX)
AASIST_ONNX_PATH=./app/ml/models/aasist.onnx
XLSR_ONNX_PATH=./app/ml/models/xlsr.onnx
ECAPA_ONNX_PATH=./app/ml/models/ecapa.onnx

# Thresholds
VAD_THRESHOLD=0.5
DEEPFAKE_THRESHOLD=0.6
SPEAKER_VERIFICATION_THRESHOLD=0.75

# Multi-Channel Alerting (Email & SMS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@voiceguard.ai
ALERT_EMAIL_TO=security@bank.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_SMS_TO=+919876543210
