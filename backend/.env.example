# VoiceGuardAI Backend Environment Variables

# App
DEBUG=true

# PostgreSQL (pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceguard

# Redis
REDIS_URL=redis://localhost:6379/0

# ML Model Paths (ONNX)
AASIST_ONNX_PATH=./app/ml/models/aasist.onnx
XLSR_ONNX_PATH=./app/ml/models/xlsr.onnx
ECAPA_ONNX_PATH=./app/ml/models/ecapa.onnx

# Thresholds
VAD_THRESHOLD=0.5
DEEPFAKE_THRESHOLD=0.6
SPEAKER_VERIFICATION_THRESHOLD=0.75
